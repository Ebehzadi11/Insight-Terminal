# Supabase Configuration
# Get these values from your Supabase project settings: https://app.supabase.com/project/YOUR_PROJECT_ID/settings/api

# Supabase Project URL (found in Project Settings > API)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase Anonymous/Public Key (found in Project Settings > API)
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Supabase Project ID (for type generation script)
SUPABASE_PROJECT_ID=your_project_id_here

# Supabase Access Token (for MCP/server-side operations)
SUPABASE_ACCESS_TOKEN=your_access_token_here
